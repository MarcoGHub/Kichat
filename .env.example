# ─────────────────────────────────────────────────────────────
# Kichat / Nikita — configuration
# Copy this file to ".env" and fill in your values.
# ─────────────────────────────────────────────────────────────

# Which LLM backend to use: "anthropic" or "openai"
# - anthropic         -> Anthropic Claude API
# - openai            -> any OpenAI-compatible API (OpenAI, local Ollama,
#                        LM Studio, text-generation-webui, etc.)
PROVIDER=anthropic

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Base URL only needs changing if you use a proxy.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── OpenAI-compatible ────────────────────────────────────────
# For a LOCAL uncensored model, point this at your local server, e.g.:
#   Ollama       -> http://localhost:11434/v1
#   LM Studio    -> http://localhost:1234/v1
# The API key can be any non-empty string for most local servers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Server ───────────────────────────────────────────────────
PORT=8787

# ── Optional features ────────────────────────────────────────
# Set to "1" to allow the web_search tool (requires a search backend
# to be wired up in src/tools.js; disabled/no-op by default).
ENABLE_WEB_SEARCH=0
