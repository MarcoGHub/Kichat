# ─────────────────────────────────────────────────────────────
# Kichat / Nikita — configuration
# Copy this file to ".env" and fill in your values.
# ─────────────────────────────────────────────────────────────

# Which LLM backend to use: "anthropic" or "openai"
# - anthropic         -> Anthropic Claude API
# - openai            -> any OpenAI-compatible API (OpenAI, local Ollama,
#                        LM Studio, text-generation-webui, etc.)
PROVIDER=anthropic

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Base URL only needs changing if you use a proxy.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── OpenAI-compatible ────────────────────────────────────────
# Works with any OpenAI-compatible endpoint. Examples:
#
#   Google Gemini (recommended if you have a Gemini API key):
#     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     OPENAI_MODEL=gemini-2.5-flash        (or gemini-2.5-pro)
#     OPENAI_API_KEY=AIza...               (from https://aistudio.google.com)
#
#   Groq (free):
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_MODEL=llama-3.3-70b-versatile
#
#   Local model (uncensored): point at your own server, e.g.
#     OPENAI_BASE_URL=http://localhost:11434/v1   (Ollama)
#     The API key can be any non-empty string for most local servers.
OPENAI_API_KEY=
OPENAI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── Server ───────────────────────────────────────────────────
PORT=8787

# ── Optional features ────────────────────────────────────────
# Set to "1" to allow the web_search tool (requires a search backend
# to be wired up in src/tools.js; disabled/no-op by default).
ENABLE_WEB_SEARCH=0
